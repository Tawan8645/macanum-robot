#include <Wire.h>
#include <MPU6050.h>
#include <micro_ros_arduino.h>
#include <geometry_msgs/msg/twist.h>

MPU6050 mpu;
geometry_msgs::msg::Twist twist_msg;
rcl_publisher_t publisher;
rcl_node_t node;

void setup() {
  Wire.begin();
  mpu.initialize();

  // Micro-ROS setup
  IPAddress agent_ip(192, 168, 1, 100); // แก้ไขเป็น IP ของ ROS2 agent
  size_t agent_port = 8888;
  set_microros_transports(agent_ip, agent_port);
  rclc_support_t support;
  rcl_allocator_t allocator;
  allocator = rcl_get_default_allocator();
  rclc_support_init(&support, 0, &allocator);
  rclc_node_init_default(&node, "imu_node", "", &support);
  rclc_publisher_init_default(
    &publisher,
    &node,
    ROSIDL_GET_MSG_TYPE_SUPPORT(geometry_msgs, msg, Twist),
    "imu_data");
}

void loop() {
  // อ่านค่าจาก MPU6050
  int16_t ax, ay, az, gx, gy, gz;
  mpu.getMotion6(&ax, &ay, &az, &gx, &gy, &gz);

  // คำนวณ Odometry อย่างง่าย (ตัวอย่าง)
  float linear_x = (float)ax / 16384.0; // แปลงค่า raw เป็น g
  float angular_z = (float)gz / 131.0; // แปลงค่า raw เป็น deg/s

  // ส่งข้อมูลผ่าน Micro-ROS
  twist_msg.linear.x = linear_x;
  twist_msg.angular.z = angular_z;
  rcl_publish(&publisher, &twist_msg, NULL);

  rclc_spin_some(&node, RCL_MS_TO_NS(10)); // หน่วงเวลา
}
