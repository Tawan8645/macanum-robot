import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
import math

class ImuOdomNode(Node):
    def __init__(self):
        super().__init__('imu_odom_node')
        self.subscription = self.create_subscription(
            Twist,
            'imu_data',
            self.listener_callback,
            10)
        self.publisher = self.create_publisher(Odometry, 'odom', 10)
        self.x = 0.0
        self.y = 0.0
        self.theta = 0.0

    def listener_callback(self, msg):
        dt = 0.01 # เวลาที่ใช้ในการคำนวณ (ขึ้นอยู่กับการหน่วงเวลาใน ESP32)
        self.theta += msg.angular.z * dt
        self.x += msg.linear.x * math.cos(self.theta) * dt
        self.y += msg.linear.x * math.sin(self.theta) * dt

        odom = Odometry()
        odom.header.stamp = self.get_clock().now().to_msg()
        odom.header.frame_id = "odom"
        odom.child_frame_id = "base_link"
        odom.pose.pose.position.x = self.x
        odom.pose.pose.position.y = self.y
        odom.pose.pose.orientation.z = math.sin(self.theta / 2.0)
        odom.pose.pose.orientation.w = math.cos(self.theta / 2.0)

        self.publisher.publish(odom)

def main(args=None):
    rclpy.init(args=args)
    imu_odom_node = ImuOdomNode()
    rclpy.spin(imu_odom_node)
    rclpy.shutdown()

if __name__ == '__main__':
    main()
